<resources>
    <!-- Android 8.1+: dark navigation bar icons on a light background -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#5B4CF5</item>
        <item name="android:colorPrimary">#F2F3F8</item>
        <item name="android:colorPrimaryDark">#F2F3F8</item>
        <item name="android:textColorPrimary">#151936</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F3F8</item>
        <item name="android:windowBackground">@color/halo_case</item>
        <item name="android:navigationBarColor">#F2F3F8</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
